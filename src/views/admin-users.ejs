<h1>Admin</h1>
<%- include('partials/admin-nav', { section: section }) %>
<form method="get" action="/admin/users" class="filters">
  <label>Cari (nama, username, NIK)
    <input type="text" name="q" value="<%= q %>">
  </label>
  <button type="submit" class="btn btn-secondary">Cari</button>
  <a class="btn" href="/admin/users/baru">Tambah User</a>
</form>
<div class="table-wrap">
  <table>
    <thead><tr><th>Nama</th><th>Username</th><th>Jabatan</th><th>Departemen</th><th>Status</th><th>Aksi</th></tr></thead>
    <tbody>
      <% rows.forEach(function (u) { %>
      <tr>
        <td><%= u.name %><% if (u.is_admin) { %> <span class="status">Admin</span><% } %></td>
        <td><%= u.username %></td>
        <td><%= LEVEL_NAMES[u.level] %></td>
        <td><%= u.department_name %></td>
        <td><%= u.is_active ? 'Aktif' : 'Nonaktif' %></td>
        <td class="row-actions">
          <a class="btn btn-secondary btn-sm" href="/admin/users/<%= u.id %>/edit">Ubah</a>
          <form method="post" action="/admin/users/<%= u.id %>/status" class="inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="active" value="<%= u.is_active ? '0' : '1' %>">
            <button type="submit" class="btn btn-secondary btn-sm"><%= u.is_active ? 'Nonaktifkan' : 'Aktifkan' %></button>
          </form>
          <form method="post" action="/admin/users/<%= u.id %>/reset-password" class="inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="password" name="password" placeholder="Password baru" autocomplete="new-password" minlength="8" required>
            <button type="submit" class="btn btn-secondary btn-sm">Reset</button>
          </form>
        </td>
      </tr>
      <% }) %>
      <% if (!rows.length) { %><tr><td colspan="6" class="muted">Tidak ada user.</td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include('partials/pagination', { page: page, total: total, base: base }) %>
