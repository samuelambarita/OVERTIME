<%# Pakai: include('partials/approval-table', {rows, action}). Form massal membungkus tabel; form per baris
    ada di luar form massal (tanpa nested form) dan dikaitkan lewat atribut `form` pada tombol/input baris. %>
<% var groups = []; var byCode = {}; rows.forEach(function (r) { if (!byCode[r.code]) { byCode[r.code] = []; groups.push(byCode[r.code]); } byCode[r.code].push(r); }); %>
<form method="post" action="<%= action %>" id="bulk-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="toolbar">
    <label class="grow">Catatan (wajib saat menolak)
      <textarea name="note" data-no-enter-submit rows="2" maxlength="500"></textarea>
    </label>
    <button type="submit" name="decision" value="APPROVE" class="btn">Setujui yang dipilih</button>
    <button type="submit" name="decision" value="REJECT" class="btn btn-danger">Tolak yang dipilih</button>
  </div>
  <div class="table-wrap">
    <table>
      <thead><tr>
        <th><input type="checkbox" data-select-all aria-label="Pilih semua"></th>
        <th>Nama</th><th>Departemen</th><th>Tanggal</th><th>Jam</th><th>Durasi</th><th>Kegiatan</th><th>Peringatan</th><th>Aksi</th>
      </tr></thead>
      <% groups.forEach(function (g) { %>
      <tbody>
        <tr class="group-row"><th colspan="9"><%= g[0].code %> &middot; diajukan oleh <%= g[0].requester_name %></th></tr>
        <% g.forEach(function (r) { %>
        <tr>
          <td><input type="checkbox" name="ids" value="<%= r.id %>" aria-label="Pilih <%= r.name %>"></td>
          <td><%= r.name %></td>
          <td><%= r.department %></td>
          <td><%= r.work_date %></td>
          <td><%= r.start_time %>&ndash;<%= r.end_time %></td>
          <td><%= formatHours(durationMinutes(r.start_time, r.end_time)) %></td>
          <td class="wrap" title="<%= r.activity %>"><%= r.activity.length > 120 ? r.activity.slice(0, 120) + '…' : r.activity %></td>
          <td class="wrap"><% r.warnings.forEach(function (w) { %><span class="warn-text"><%= w %></span> <% }) %></td>
          <td class="row-actions">
            <input type="text" name="note" data-no-enter-submit form="row-<%= r.id %>" maxlength="500" placeholder="Catatan" aria-label="Catatan untuk <%= r.name %>">
            <button type="submit" form="row-<%= r.id %>" name="decision" value="APPROVE" class="btn btn-sm">Setujui</button>
            <button type="submit" form="row-<%= r.id %>" name="decision" value="REJECT" class="btn btn-sm btn-danger">Tolak</button>
          </td>
        </tr>
        <% }) %>
      </tbody>
      <% }) %>
      <% if (!rows.length) { %><tbody><tr><td colspan="9" class="muted">Tidak ada pengajuan yang menunggu.</td></tr></tbody><% } %>
    </table>
  </div>
</form>
<% rows.forEach(function (r) { %>
<form method="post" action="<%= action %>" id="row-<%= r.id %>">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="ids" value="<%= r.id %>">
</form>
<% }) %>
